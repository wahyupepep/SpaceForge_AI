POSTGRES_DB=specforge
POSTGRES_USER=specforge
POSTGRES_PASSWORD=specforge
DATABASE_URL=postgresql+asyncpg://specforge:specforge@db:5432/specforge
APP_ENV=development
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000"]
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_REASONING_MODEL=gpt-5
OPENAI_REQUIREMENT_ANALYST_MODEL=gpt-5
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_EXISTING_SYSTEM_ANALYST_MODEL=gpt-5
OPENAI_SOLUTION_ANALYST_MODEL=gpt-5
OPENAI_FLOW_DESIGNER_MODEL=gpt-5-mini
OPENAI_UI_PROTOTYPE_MODEL=gpt-5-mini
OPENAI_TECHNICAL_ARCHITECT_MODEL=gpt-5
OPENAI_QA_ANALYST_MODEL=gpt-5
OPENAI_SA_REVIEWER_MODEL=gpt-5
OPENAI_DEVELOPMENT_PLANNER_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
RESEARCH_WEB_SEARCH_ENABLED=true
AI_TEMPERATURE=
AI_MAX_OUTPUT_TOKENS=4096
AI_PROTOTYPE_MAX_OUTPUT_TOKENS=12000
QUALITY_MAX_REVISIONS=5
ORCHESTRATOR_LEASE_SECONDS=900
MAX_REQUEST_BODY_BYTES=5242880
FILE_STORAGE_ROOT=/data/files
